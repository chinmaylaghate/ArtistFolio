DEFINE SCHEMA

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE Profile (
        "___createTime"    TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"     REFERENCE QUERYABLE,
        "___etag"          STRING,
        "___modTime"       TIMESTAMP,
        "___modifiedBy"    REFERENCE,
        "___recordID"      REFERENCE QUERYABLE,
        displayName        STRING,
        bio                STRING,
        role               STRING QUERYABLE,
        location           STRING,
        website            STRING,
        instagramHandle    STRING,
        contactEmail       STRING,
        phone              STRING,
        whatsapp           STRING,
        acceptsCommissions INT64,
        followerCount      INT64,
        avatar             ASSET,
        searchTokens       LIST<STRING> QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Artwork (
        "___createTime" TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"  REFERENCE QUERYABLE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        title           STRING,
        details         STRING,
        price           DOUBLE QUERYABLE SORTABLE,
        priceOnRequest  INT64,
        careNote        STRING,
        showCareTips    INT64,
        series          STRING QUERYABLE,
        sizeClass       STRING QUERYABLE,
        viewCount       INT64,
        likeCount       INT64,
        status          STRING QUERYABLE,
        medium          STRING QUERYABLE,
        style           STRING QUERYABLE,
        width           DOUBLE,
        height          DOUBLE,
        unit            STRING,
        year            INT64,
        tags            LIST<STRING>,
        searchTokens    LIST<STRING> QUERYABLE,
        thumbnail       ASSET,
        images          LIST<ASSET>,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Report (
        "___createTime" TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        targetType      STRING,
        targetID        STRING,
        reason          STRING,
        note            STRING,
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE Review (
        "___createTime" TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"  REFERENCE QUERYABLE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        artistID        STRING QUERYABLE,
        rating          INT64,
        text            STRING,
        relationship    STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE ArtworkLike (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE QUERYABLE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        targetID        STRING QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE ArtistFollow (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE QUERYABLE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        targetID        STRING QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE ArtworkView (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE QUERYABLE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        targetID        STRING QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SavedArtwork (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        targetID        STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE FollowedArtist (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        targetID        STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE BlockedArtist (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        targetID        STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );
